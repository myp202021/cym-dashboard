{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/fiscalizacion",
      "destination": "/fiscalizacion.html"
    },
    {
      "source": "/demo",
      "destination": "/demo-whatsapp.html"
    },
    {
      "source": "/seguimiento",
      "destination": "/seguimiento.html"
    },
    {
      "source": "/mensajes",
      "destination": "/mensajes.html"
    }
  ],
  "functions": {
    "api/organico-detalle.js": {
      "includeFiles": "privado/**"
    },
    "api/meta-webhook.js": {
      "includeFiles": "data/propiedades-catalogo.json"
    },
    "api/lead-organico.js": {
      "includeFiles": "data/propiedades-catalogo.json"
    },
    "api/meta-sondeo.js": {
      "includeFiles": "data/propiedades-catalogo.json",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/contacto",
      "destination": "https://wa.me/56934018822",
      "permanent": false
    },
    {
      "source": "/contacto.html",
      "destination": "https://wa.me/56934018822",
      "permanent": false
    },
    {
      "source": "/privado/:path*",
      "destination": "/seguimiento",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/seguimiento",
      "permanent": false
    }
  ]
}
